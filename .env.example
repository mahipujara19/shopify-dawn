# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — each developer maintains their own copy.

# Shopify store handle (the part before .myshopify.com)
STORE=demo-hwpl

# Production / live theme ID. Same for everyone on the team.
PROD_THEME_ID=184157995287

# Your personal development theme ID. Each developer should use their own.
# Create one with: shopify theme push --unpublished --json
DEV_THEME_ID=187107770647

# Optional: incoming webhook URL for deploy notifications.
# Supported: Slack, Discord, Google Chat (auto-detected from URL).
#   - Slack:       https://hooks.slack.com/services/...
#   - Discord:     https://discord.com/api/webhooks/...
#   - Google Chat: https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...
# Leave empty to disable.
DEPLOY_WEBHOOK_URL=

# Optional: how the webhook identifies you (defaults to git user.name)
DEPLOY_AUTHOR=

# Optional: enable creating a Shopify-side rollback theme before each live push
# (duplicates current live as `rollback-YYYYMMDD-HHMM` unpublished theme)
CREATE_ROLLBACK_THEME=true

# Optional: enable Shopify-CLI-side lock via the deploy-lock git branch
USE_DEPLOY_LOCK=true

# How many minutes a deploy lock is valid before it auto-expires
DEPLOY_LOCK_TTL_MINUTES=15

# How many local backup snapshots to keep in ./backups/ (auto-pruned)
BACKUPS_KEEP=5

# How many Shopify-side rollback themes to keep on the store (auto-pruned)
ROLLBACK_KEEP=5
