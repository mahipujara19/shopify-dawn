{% doc %}
  @prompt
    Create a footer content block matching this layout: three columns on desktop, with a wider About us column on the left, a Shop navigation column in the middle, and a Support navigation column on the right. Left column has an editable heading, bold store name (initially goodthings), editable short brand description, and optional editable address left blank initially. Do not invent business details. Middle and right columns have editable headings initially Shop and Support and independently selectable Shopify menus, using real menu links rather than dummy destinations. Use compact readable text, generous space between columns, and left-aligned content. Stack columns cleanly on mobile. Inherit the current theme colors and typography rather than introducing a new color palette. Make all text, spacing, and menu selections editable. This should supply the reference's content arrangement, not just recolor an existing footer. Avoid duplicating existing footer copyright and social utilities.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-content-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; box-sizing: border-box; color: rgb(var(--color-foreground)); font-family: var(--font-body-family); font-style: var(--font-body-style); font-weight: var(--font-body-weight); }
  .ai-footer-content-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr; column-gap: {{ block.settings.column_gap }}px; row-gap: 32px; text-align: left; }
  .ai-footer-content-{{ ai_gen_id }}__column { min-width: 0; }
  .ai-footer-content-{{ ai_gen_id }}__heading { margin: 0 0 14px; color: inherit; font-family: var(--font-heading-family); font-style: var(--font-heading-style); font-weight: var(--font-heading-weight); font-size: {{ block.settings.heading_size }}px; line-height: 1.25; }
  .ai-footer-content-{{ ai_gen_id }}__store-name { display: block; margin: 0 0 10px; font-size: {{ block.settings.text_size }}px; line-height: 1.5; }
  .ai-footer-content-{{ ai_gen_id }}__description, .ai-footer-content-{{ ai_gen_id }}__address { font-size: {{ block.settings.text_size }}px; line-height: 1.6; }
  .ai-footer-content-{{ ai_gen_id }}__description > :first-child, .ai-footer-content-{{ ai_gen_id }}__address > :first-child { margin-top: 0; }
  .ai-footer-content-{{ ai_gen_id }}__description > :last-child, .ai-footer-content-{{ ai_gen_id }}__address > :last-child { margin-bottom: 0; }
  .ai-footer-content-{{ ai_gen_id }}__address { margin-top: 14px; }
  .ai-footer-content-{{ ai_gen_id }}__menu { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ai-footer-content-{{ ai_gen_id }}__menu a { color: inherit; font-size: {{ block.settings.text_size }}px; line-height: 1.5; text-decoration: none; text-underline-offset: 0.2em; }
  .ai-footer-content-{{ ai_gen_id }}__menu a:hover { text-decoration: underline; }
  .ai-footer-content-{{ ai_gen_id }}__menu a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  @media screen and (max-width: 749px) { .ai-footer-content-{{ ai_gen_id }} { width: 100%; } .ai-footer-content-{{ ai_gen_id }}__grid { grid-template-columns: 1fr; row-gap: 28px; } }
{% endstyle %}

<div class="ai-footer-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-content-{{ ai_gen_id }}__grid">
    <section class="ai-footer-content-{{ ai_gen_id }}__column" aria-labelledby="ai-footer-about-{{ ai_gen_id }}">
      <h2 id="ai-footer-about-{{ ai_gen_id }}" class="ai-footer-content-{{ ai_gen_id }}__heading">{{ block.settings.about_heading | escape }}</h2>
      <strong class="ai-footer-content-{{ ai_gen_id }}__store-name">{{ block.settings.store_name | escape }}</strong>
      {% if block.settings.description != blank %}<div class="ai-footer-content-{{ ai_gen_id }}__description">{{ block.settings.description | escape | newline_to_br }}</div>{% endif %}
      {% if block.settings.address != blank %}<div class="ai-footer-content-{{ ai_gen_id }}__address">{{ block.settings.address | escape | newline_to_br }}</div>{% endif %}
    </section>
    <nav class="ai-footer-content-{{ ai_gen_id }}__column" aria-labelledby="ai-footer-shop-{{ ai_gen_id }}">
      <h2 id="ai-footer-shop-{{ ai_gen_id }}" class="ai-footer-content-{{ ai_gen_id }}__heading">{{ block.settings.shop_heading | escape }}</h2>
      {% if block.settings.shop_menu != blank %}<ul class="ai-footer-content-{{ ai_gen_id }}__menu">{% for link in block.settings.shop_menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul>{% endif %}
    </nav>
    <nav class="ai-footer-content-{{ ai_gen_id }}__column" aria-labelledby="ai-footer-support-{{ ai_gen_id }}">
      <h2 id="ai-footer-support-{{ ai_gen_id }}" class="ai-footer-content-{{ ai_gen_id }}__heading">{{ block.settings.support_heading | escape }}</h2>
      {% if block.settings.support_menu != blank %}<ul class="ai-footer-content-{{ ai_gen_id }}__menu">{% for link in block.settings.support_menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul>{% endif %}
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Footer content columns",
  "settings": [
    { "type": "header", "content": "About us" },
    { "type": "text", "id": "about_heading", "label": "Heading", "default": "About us" },
    { "type": "text", "id": "store_name", "label": "Store name", "default": "goodthings" },
    { "type": "textarea", "id": "description", "label": "Brand description" },
    { "type": "textarea", "id": "address", "label": "Address" },
    { "type": "header", "content": "Shop navigation" },
    { "type": "text", "id": "shop_heading", "label": "Heading", "default": "Shop" },
    { "type": "link_list", "id": "shop_menu", "label": "Menu" },
    { "type": "header", "content": "Support navigation" },
    { "type": "text", "id": "support_heading", "label": "Heading", "default": "Support" },
    { "type": "link_list", "id": "support_menu", "label": "Menu" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "column_gap", "label": "Column spacing", "min": 16, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 14, "max": 30, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 }
  ],
  "presets": [{ "name": "Footer content columns" }],
  "tag": null,
  "class": "footer-content-columns"
}
{% endschema %}