{%- assign s = section.settings -%}

<section
  id="ModularBentoPromos-{{ section.id }}"
  class="mbp mbp--{{ s.card_layout | default: 'equal' }}{% if s.reverse %} mbp--reverse{% endif %}"
  style="
    --mbp-min-h: {{ s.min_height }}px;
    --mbp-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};
    --mbp-pt: {{ s.padding_top }}px;
    --mbp-pb: {{ s.padding_bottom }}px;
  "
>
  <div class="page-width">
    <div class="mbp__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign col = b.collection
          assign card_image = b.image
          if card_image == blank and b.product != blank
            assign card_image = b.product.featured_media.preview_image
          endif
          if card_image == blank and col != blank
            assign card_image = col.featured_image
          endif
          assign card_link = b.button_link
          if card_link == blank and col != blank
            assign card_link = col.url
          endif
        -%}
        <article
          class="mbp__card mbp__card--{{ forloop.index }}{% if card_image != blank %} mbp__card--image{% endif %}"
          style="--mbp-bg: {{ b.background }}; --mbp-text: {{ b.text_color }}; --mbp-btn: {{ b.button_color }}; --mbp-btn-text: {{ b.button_text_color }};"
          {{ block.shopify_attributes }}
        >
          {%- if card_image != blank -%}
            <div class="mbp__media">
              {{
                card_image
                | image_url: width: 1800
                | image_tag:
                  class: 'mbp__img',
                  widths: '500, 800, 1200, 1800',
                  sizes: '(min-width: 990px) 60vw, 100vw',
                  loading: 'lazy',
                  alt: card_image.alt
              }}
            </div>
          {%- endif -%}

          {%- if b.badge != blank -%}
            <span class="mbp__badge">{{ b.badge | escape }}</span>
          {%- endif -%}

          <div class="mbp__content">
            {%- if b.eyebrow != blank -%}
              <span class="mbp__eyebrow">{{ b.eyebrow | escape }}</span>
            {%- endif -%}
            {%- if b.heading != blank -%}
              <h3 class="mbp__heading">{{ b.heading | escape }}</h3>
            {%- endif -%}
            {%- if b.subtitle != blank -%}
              <p class="mbp__subtitle">{{ b.subtitle | escape }}</p>
            {%- endif -%}
            {%- if b.button_label != blank -%}
              <a
                class="mbp__btn"
                {% if card_link != blank %}
                  href="{{ card_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
              >
                {{- b.button_label | escape -}}
                <span aria-hidden="true" class="mbp__arrow">&rarr;</span>
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .mbp { padding-top: calc(var(--mbp-pt) * 0.75); padding-bottom: calc(var(--mbp-pb) * 0.75); }
  .mbp__grid { display: grid; grid-template-columns: 1fr; gap: 1.2rem; }
  .mbp__card {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: calc(var(--mbp-min-h) * 0.85);
    border-radius: 16px;
    overflow: hidden;
    background: var(--mbp-bg);
    color: var(--mbp-text);
    isolation: isolate;
  }
  .mbp__media { position: absolute; inset: 0; z-index: -1; }
  .mbp__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, var(--mbp-overlay)), rgba(0, 0, 0, calc(var(--mbp-overlay) * 0.2)) 60%, transparent);
  }
  .mbp__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .mbp__card:hover .mbp__img { transform: scale(1.05); }
  .mbp__card--image { color: #fff; }

  .mbp__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 2.8rem 2.4rem;
  }
  .mbp__eyebrow {
    margin-bottom: 1rem;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .mbp__heading {
    margin: 0 0 1rem;
    max-width: 14ch;
    font-size: clamp(3.2rem, 4.6vw, 6.4rem);
    line-height: 0.92;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: inherit;
  }
  .mbp__subtitle { margin: 0 0 2.4rem; max-width: 40ch; font-size: 1.5rem; line-height: 1.5; opacity: 0.88; }
  .mbp__btn {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.8rem;
    padding: 0 2.8rem;
    border-radius: 999px;
    background: var(--mbp-btn);
    color: var(--mbp-btn-text);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .mbp__card--image .mbp__btn { background: #fff; color: #0b0b0b; }
  /* Make the whole card clickable via the CTA */
  .mbp__btn::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .mbp__arrow { transition: transform 0.25s ease; }
  .mbp__card:hover .mbp__arrow { transform: translateX(5px); }
  .mbp__btn:focus-visible { outline: none; }
  .mbp__card:has(.mbp__btn:focus-visible) { outline: 3px solid #0b0b0b; outline-offset: 3px; }
  .mbp__badge {
    position: absolute;
    top: 1.6rem;
    right: 1.6rem;
    z-index: 2;
    padding: 0.8rem 1.5rem;
    border-radius: 999px;
    background: #fff;
    color: #0b0b0b;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.5);
  }
  .mbp__card:not(.mbp__card--image) .mbp__badge { background: var(--mbp-text); color: var(--mbp-bg); }

  @supports (animation-timeline: view()) {
    .mbp__card { animation: mbp-reveal linear both; animation-timeline: view(); animation-range: entry 0% entry 40%; }
  }
  @keyframes mbp-reveal { from { opacity: 0; transform: translateY(48px) scale(0.98); } to { opacity: 1; transform: none; } }

  @media screen and (min-width: 990px) {
    .mbp { padding-top: var(--mbp-pt); padding-bottom: var(--mbp-pb); }
    .mbp__grid { grid-template-columns: 3fr 2fr; gap: 1.6rem; }
    .mbp--reverse .mbp__grid { grid-template-columns: 2fr 3fr; }
    .mbp--reverse .mbp__card--1 { order: 2; }
    .mbp--equal .mbp__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mbp__card { min-height: var(--mbp-min-h); }
    .mbp__content { padding: 4.8rem 4.4rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mbp__img, .mbp__arrow { transition: none; }
    .mbp__card { animation: none !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Modular: Bento promos",
  "tag": "div",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 2,
  "settings": [
    {
      "type": "select",
      "id": "card_layout",
      "label": "Card widths (desktop)",
      "options": [
        { "value": "equal", "label": "Two equal cards" },
        { "value": "wide", "label": "60 / 40" }
      ],
      "default": "equal"
    },
    { "type": "checkbox", "id": "reverse", "label": "Put the wide card on the right (60 / 40 only)", "default": false },
    { "type": "range", "id": "min_height", "label": "Card height (desktop)", "min": 320, "max": 800, "step": 20, "unit": "px", "default": 600 },
    { "type": "range", "id": "overlay_opacity", "label": "Image darkening", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 65 },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Used for the image fallback and button link." },
        { "type": "product", "id": "product", "label": "Image from product", "info": "Uses this product's photo so the card looks different from the category tiles." },
        { "type": "image_picker", "id": "image", "label": "Image override", "info": "Leave empty for a solid color card when no collection is set." },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow tag", "default": "Limited time" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "The weekend edit" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Easy layers and soft textures for slower days." },
        { "type": "text", "id": "badge", "label": "Corner badge", "default": "Save 40%" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the collection." },
        { "type": "header", "content": "Colors (used when there is no image)" },
        { "type": "color", "id": "background", "label": "Card background", "default": "#F3E6DA" },
        { "type": "color", "id": "text_color", "label": "Text", "default": "#0B0B0B" },
        { "type": "color", "id": "button_color", "label": "Button", "default": "#0B0B0B" },
        { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Modular: Bento promos",
      "blocks": [
        { "type": "promo" },
        {
          "type": "promo",
          "settings": {
            "eyebrow": "Just landed",
            "heading": "Everyday essentials",
            "subtitle": "The pieces you reach for first.",
            "badge": "New",
            "button_label": "Explore",
            "background": "#E3EAE4"
          }
        }
      ]
    }
  ]
}
{% endschema %}
