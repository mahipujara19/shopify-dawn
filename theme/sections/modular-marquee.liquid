{%- assign s = section.settings -%}

<section
  id="ModularMarquee-{{ section.id }}"
  class="mmq{% if s.tilt %} mmq--tilt{% endif %}"
  style="
    --mmq-bg: {{ s.background }};
    --mmq-text: {{ s.text_color }};
    --mmq-speed: {{ s.speed }}s;
    --mmq-size: {{ s.text_size }}px;
    --mmq-pt: {{ s.padding_top }}px;
    --mmq-pb: {{ s.padding_bottom }}px;
  "
>
  <div class="mmq__band"{% if s.link != blank %} data-has-link{% endif %}>
    {%- if s.link != blank -%}<a class="mmq__link" href="{{ s.link }}">{%- endif -%}
    <div class="mmq__track">
      {%- for copy in (1..4) -%}
        <ul class="mmq__group" role="list"{% if copy > 1 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <li class="mmq__item"{% if copy == 1 %} {{ block.shopify_attributes }}{% endif %}>
              <span>{{ block.settings.text | escape }}</span>
              <span class="mmq__sep" aria-hidden="true">{{ s.separator | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
    {%- if s.link != blank -%}</a>{%- endif -%}
  </div>
</section>

{% stylesheet %}
  .mmq {
    padding-top: var(--mmq-pt);
    padding-bottom: var(--mmq-pb);
    overflow: hidden;
  }
  .mmq__band {
    background: var(--mmq-bg);
    color: var(--mmq-text);
    padding: 1.6rem 0;
  }
  .mmq--tilt .mmq__band { transform: rotate(-1.5deg) scale(1.03); }
  .mmq__link { display: block; color: inherit; text-decoration: none; }
  .mmq__track { display: flex; width: max-content; animation: mmq-scroll var(--mmq-speed) linear infinite; }
  .mmq__band:hover .mmq__track { animation-play-state: paused; }
  .mmq__group { display: flex; flex-shrink: 0; list-style: none; margin: 0; padding: 0; }
  .mmq__item {
    display: flex;
    align-items: center;
    white-space: nowrap;
    font-size: clamp(1.6rem, 2.4vw, var(--mmq-size));
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .mmq__sep { padding: 0 2.4rem; opacity: 0.6; }
  @keyframes mmq-scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .mmq__track { animation: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Modular: Scrolling text",
  "tag": "div",
  "class": "section",
  "disabled_on": { "groups": ["header"] },
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "separator", "label": "Separator", "default": "✦" },
    { "type": "url", "id": "link", "label": "Link (optional)" },
    { "type": "range", "id": "speed", "label": "Loop duration (higher is slower)", "min": 10, "max": 80, "step": 2, "unit": "s", "default": 30 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 16, "max": 64, "step": 2, "unit": "px", "default": 32 },
    { "type": "checkbox", "id": "tilt", "label": "Tilted band", "default": false },
    { "type": "color", "id": "background", "label": "Background", "default": "#0B0B0B" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Phrase",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "New season" }]
    }
  ],
  "presets": [
    {
      "name": "Modular: Scrolling text",
      "blocks": [
        { "type": "text", "settings": { "text": "New season" } },
        { "type": "text", "settings": { "text": "Heavyweight basics" } },
        { "type": "text", "settings": { "text": "Built to last" } },
        { "type": "text", "settings": { "text": "Made to move" } }
      ]
    }
  ]
}
{% endschema %}
