{%- assign s = section.settings -%}

<section
  id="ModularEditSlider-{{ section.id }}"
  class="mes"
  style="
    --mes-bg: {{ s.background }};
    --mes-text: {{ s.text_color }};
    --mes-ratio: {{ s.image_ratio }};
    --mes-pt: {{ s.padding_top }}px;
    --mes-pb: {{ s.padding_bottom }}px;
  "
>
  <modular-edit-slider class="mes__inner page-width">
    <div class="mes__intro">
      <div class="mes__sticky">
        {%- if s.eyebrow != blank -%}
          <span class="mes__eyebrow">{{ s.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="mes__heading">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.description != blank -%}
          <div class="mes__description">{{ s.description }}</div>
        {%- endif -%}
        {%- if s.link_label != blank -%}
          <a class="mes__link" href="{{ s.link | default: routes.all_products_collection_url }}">{{ s.link_label | escape }}</a>
        {%- endif -%}
        <div class="mes__controls">
          <button type="button" class="mes__arrow" data-dir="-1" aria-label="Previous" aria-controls="MesTrack-{{ section.id }}">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="mes__arrow" data-dir="1" aria-label="Next" aria-controls="MesTrack-{{ section.id }}">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="mes__rail">
      <ul id="MesTrack-{{ section.id }}" class="mes__track" role="list" tabindex="0" aria-label="{{ s.heading | default: 'Shop the edit' | escape }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign p = b.product
            assign col = b.collection
            assign card_image = b.image
            assign hover_image = nil
            if p != blank
              if card_image == blank
                assign card_image = p.featured_media.preview_image
              endif
              if p.media.size > 1
                assign hover_image = p.media[1].preview_image
              endif
              assign card_title = b.title | default: p.title
              assign card_url = b.link | default: p.url
            else
              if card_image == blank and col != blank
                assign card_image = col.featured_image
              endif
              assign card_title = b.title | default: col.title
              assign card_url = b.link | default: col.url
            endif
          -%}
          <li class="mes__slide" {{ block.shopify_attributes }}>
            <a
              class="mes__card"
              {% if card_url != blank %}
                href="{{ card_url }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              <div class="mes__media{% if hover_image != blank %} mes__media--hover{% endif %}">
                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 1000
                    | image_tag:
                      class: 'mes__img',
                      widths: '400, 600, 800, 1000',
                      sizes: '(min-width: 990px) 22vw, 75vw',
                      loading: 'lazy',
                      alt: card_title
                  }}
                  {%- if hover_image != blank -%}
                    {{
                      hover_image
                      | image_url: width: 1000
                      | image_tag: class: 'mes__img mes__img--hover', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 22vw, 75vw', loading: 'lazy', alt: ''
                    }}
                  {%- endif -%}
                {%- else -%}
                  {%- capture placeholder -%}product-{{ forloop.index | modulo: 6 | plus: 1 }}{%- endcapture -%}
                  {{ placeholder | placeholder_svg_tag: 'mes__img' }}
                {%- endif -%}
                {%- if b.tag != blank -%}
                  <span class="mes__tag">{{ b.tag | escape }}</span>
                {%- elsif p != blank and p.compare_at_price > p.price -%}
                  <span class="mes__tag mes__tag--sale">Sale</span>
                {%- endif -%}
              </div>
              <div class="mes__meta">
                <span class="mes__title">{{ card_title | default: 'Shop the look' | escape }}</span>
                {%- if p != blank -%}
                  <span class="mes__price">
                    {%- if p.compare_at_price > p.price -%}
                      <s>{{ p.compare_at_price | money }}</s>
                    {%- endif -%}
                    {{ p.price | money }}
                  </span>
                {%- elsif b.caption != blank -%}
                  <span class="mes__caption">{{ b.caption | escape }}</span>
                {%- endif -%}
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      <div class="mes__progress" aria-hidden="true"><span class="mes__progress-bar"></span></div>
    </div>
  </modular-edit-slider>
</section>

{% stylesheet %}
  .mes {
    padding-top: calc(var(--mes-pt) * 0.75);
    padding-bottom: calc(var(--mes-pb) * 0.75);
    background: var(--mes-bg);
    color: var(--mes-text);
    overflow: hidden;
  }
  .mes__inner { display: grid; grid-template-columns: 1fr; gap: 2.8rem; }
  .mes__eyebrow {
    display: block;
    margin-bottom: 1rem;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .mes__heading {
    margin: 0 0 1.6rem;
    font-size: clamp(3.4rem, 5vw, 6.8rem);
    line-height: 0.9;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--mes-text);
  }
  .mes__description { max-width: 40ch; font-size: 1.5rem; line-height: 1.6; opacity: 0.75; }
  .mes__description p { margin: 0 0 1rem; }
  .mes__link {
    display: inline-block;
    margin-top: 0.8rem;
    padding-bottom: 0.3rem;
    border-bottom: 2px solid currentColor;
    color: inherit;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .mes__controls { display: flex; gap: 1rem; margin-top: 2.8rem; }
  .mes__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5.2rem;
    height: 5.2rem;
    border-radius: 50%;
    border: 2px solid currentColor;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, opacity 0.25s ease, transform 0.25s ease;
  }
  .mes__arrow:hover:not([disabled]) { background: var(--mes-text); color: var(--mes-bg); transform: scale(1.06); }
  .mes__arrow[disabled] { opacity: 0.25; cursor: default; }
  .mes__arrow:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  .mes__rail { min-width: 0; }
  .mes__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 72%;
    gap: 1.2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .mes__track::-webkit-scrollbar { display: none; }
  .mes__track:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .mes__slide { scroll-snap-align: start; }
  .mes__card { display: block; color: inherit; text-decoration: none; }
  .mes__media {
    position: relative;
    aspect-ratio: var(--mes-ratio);
    border-radius: 12px;
    overflow: hidden;
    background: #f2f2f2;
  }
  .mes__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.4s ease;
  }
  .mes__img--hover { opacity: 0; }
  .mes__card:hover .mes__img { transform: scale(1.05); }
  .mes__card:hover .mes__media--hover .mes__img--hover { opacity: 1; }
  .mes__tag {
    position: absolute;
    top: 1.2rem;
    left: 1.2rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: #fff;
    color: #0b0b0b;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .mes__tag--sale { background: #e4002b; color: #fff; }
  .mes__meta { display: flex; flex-direction: column; gap: 0.4rem; padding-top: 1.4rem; }
  .mes__title { font-size: 1.45rem; font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; }
  .mes__price, .mes__caption { font-size: 1.4rem; opacity: 0.7; }
  .mes__price s { margin-right: 0.6rem; opacity: 0.6; }

  .mes__progress { position: relative; height: 3px; margin-top: 2.4rem; border-radius: 3px; background: color-mix(in srgb, var(--mes-text) 18%, transparent); overflow: hidden; }
  .mes__progress-bar {
    position: absolute;
    inset: 0;
    background: var(--mes-text);
    transform-origin: left;
    transform: scaleX(var(--mes-progress, 0.33));
    transition: transform 0.3s ease;
  }

  @media screen and (min-width: 990px) {
    .mes { padding-top: var(--mes-pt); padding-bottom: var(--mes-pb); }
    .mes__inner { grid-template-columns: minmax(28rem, 1fr) 2.6fr; gap: 5.6rem; align-items: start; }
    .mes__intro { align-self: stretch; }
    .mes__sticky { position: sticky; top: 4rem; }
    .mes__track { grid-auto-columns: calc((100% - 2 * 1.6rem) / 3); gap: 1.6rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mes__track { scroll-behavior: auto; }
    .mes__img, .mes__progress-bar { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('modular-edit-slider')) {
    customElements.define(
      'modular-edit-slider',
      class ModularEditSlider extends HTMLElement {
        connectedCallback() {
          this.track = this.querySelector('.mes__track');
          this.buttons = this.querySelectorAll('.mes__arrow');
          if (!this.track) return;
          this.onClick = (event) => {
            const dir = Number(event.currentTarget.dataset.dir);
            const slide = this.track.querySelector('.mes__slide');
            const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
            const step = slide ? slide.getBoundingClientRect().width + gap : this.track.clientWidth;
            this.track.scrollBy({ left: dir * step, behavior: 'smooth' });
          };
          this.update = () => {
            const max = this.track.scrollWidth - this.track.clientWidth;
            const left = this.track.scrollLeft;
            this.buttons.forEach((button) => {
              const dir = Number(button.dataset.dir);
              button.disabled = dir < 0 ? left <= 2 : left >= max - 2;
            });
            const visible = this.track.scrollWidth ? this.track.clientWidth / this.track.scrollWidth : 1;
            const progress = max > 0 ? visible + (1 - visible) * (left / max) : 1;
            this.style.setProperty('--mes-progress', Math.min(1, progress).toFixed(3));
          };
          this.buttons.forEach((button) => button.addEventListener('click', this.onClick));
          this.track.addEventListener('scroll', this.update, { passive: true });
          this.resizeObserver = new ResizeObserver(this.update);
          this.resizeObserver.observe(this.track);
          this.update();
        }

        disconnectedCallback() {
          this.buttons?.forEach((button) => button.removeEventListener('click', this.onClick));
          this.track?.removeEventListener('scroll', this.update);
          this.resizeObserver?.disconnect();
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Modular: Shop the edit",
  "tag": "div",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the edit" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>A tight selection of what we're reaching for right now, styled together.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Card image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 4", "label": "Tall" },
        { "value": "2 / 3", "label": "Extra tall" }
      ],
      "default": "3 / 4"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#0B0B0B" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Shows the product photo, name and price." },
        { "type": "collection", "id": "collection", "label": "Or a collection", "info": "Used when no product is set." },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "tag", "label": "Corner tag", "info": "e.g. New, Limited" },
        { "type": "text", "id": "caption", "label": "Caption (collections only)", "default": "Explore the look" },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Modular: Shop the edit",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
