{%- assign s = section.settings -%}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- if s.image_shape == 'blob' -%}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if s.quick_add == 'standard' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<section
  id="ModularTabbedProducts-{{ section.id }}"
  class="mtp"
  style="
    --mtp-cols: {{ s.columns_desktop }};
    --mtp-cols-mobile: {{ s.columns_mobile }};
    --mtp-accent: {{ s.accent_color }};
    --mtp-bg: {{ s.background }};
    --mtp-pt: {{ s.padding_top }}px;
    --mtp-pb: {{ s.padding_bottom }}px;
  "
>
  <modular-tabs class="page-width">
    <div class="mtp__header">
      <div class="mtp__titles">
        {%- if s.eyebrow != blank -%}
          <span class="mtp__eyebrow">{{ s.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="mtp__heading">{{ s.heading | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if s.shop_all_label != blank and section.blocks.size > 0 -%}
        <a
          class="mtp__shop-all"
          href="{{ section.blocks.first.settings.collection.url | default: routes.all_products_collection_url }}"
        >
          {{- s.shop_all_label | escape }}
          <span aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}
    </div>

    <div class="mtp__bar">
        <div class="mtp__tabs" role="tablist" aria-label="{{ s.heading | default: 'Products' | escape }}">
          {%- for block in section.blocks -%}
            <button
              type="button"
              role="tab"
              class="mtp__tab"
              id="MtpTab-{{ section.id }}-{{ forloop.index }}"
              aria-controls="MtpPanel-{{ section.id }}-{{ forloop.index }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              data-url="{{ block.settings.collection.url | default: routes.all_products_collection_url }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label | escape -}}
            </button>
          {%- endfor -%}
          <span class="mtp__indicator" aria-hidden="true"></span>
        </div>
    </div>

    {%- for block in section.blocks -%}
      {%- assign tab_index = forloop.index -%}
      <div
        class="mtp__panel"
        role="tabpanel"
        id="MtpPanel-{{ section.id }}-{{ tab_index }}"
        aria-labelledby="MtpTab-{{ section.id }}-{{ tab_index }}"
        {% unless forloop.first %}
          hidden
        {% endunless %}
      >
        <ul class="mtp__grid" role="list">
          {%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
            {%- for product in block.settings.collection.products limit: s.products_to_show -%}
              <li class="mtp__item">
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: s.image_ratio,
                  image_shape: s.image_shape,
                  show_secondary_image: s.show_secondary_image,
                  show_vendor: s.show_vendor,
                  show_rating: s.show_rating,
                  lazy_load: true,
                  skip_styles: true,
                  section_id: section.id,
                  quick_add: s.quick_add,
                  product_view_context: 'collection'
                %}
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..s.products_to_show) -%}
              <li class="mtp__item">
                {% render 'card-product',
                  media_aspect_ratio: s.image_ratio,
                  image_shape: s.image_shape,
                  show_vendor: s.show_vendor,
                  lazy_load: true,
                  skip_styles: true
                %}
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    {%- endfor -%}
  </modular-tabs>
</section>

{% stylesheet %}
  modular-tabs { display: block; }
  .mtp {
    padding-top: calc(var(--mtp-pt) * 0.75);
    padding-bottom: calc(var(--mtp-pb) * 0.75);
    background: var(--mtp-bg);
  }
  .mtp__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.4rem;
  }
  .mtp__eyebrow {
    display: block;
    margin-bottom: 1rem;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .mtp__heading {
    margin: 0;
    font-size: clamp(3.2rem, 4.4vw, 6rem);
    line-height: 0.92;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .mtp__shop-all {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 4.4rem;
    padding: 0 2.2rem;
    border: 1.5px solid rgb(var(--color-foreground));
    border-radius: 999px;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground));
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  .mtp__shop-all:hover { background: rgb(var(--color-foreground)); color: rgb(var(--color-background)); }

  /* Pill tabs with a sliding active pill */
  .mtp__bar { margin-bottom: 3.2rem; overflow-x: auto; scrollbar-width: none; }
  .mtp__bar::-webkit-scrollbar { display: none; }
  .mtp__tabs {
    position: relative;
    display: inline-flex;
    gap: 0.4rem;
    padding: 0.5rem;
    border-radius: 999px;
    background: rgba(var(--color-foreground), 0.06);
  }
  .mtp__tab {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    min-height: 4.2rem;
    padding: 0 2.2rem;
    border: 0;
    border-radius: 999px;
    background: none;
    font: inherit;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(var(--color-foreground), 0.6);
    cursor: pointer;
    transition: color 0.3s ease;
  }
  .mtp__tab:hover { color: rgb(var(--color-foreground)); }
  .mtp__tab[aria-selected='true'] { color: #fff; }
  .mtp__tab:focus-visible { outline: 2px solid var(--mtp-accent); outline-offset: 2px; }
  .mtp__indicator {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0;
    width: 0;
    border-radius: 999px;
    background: var(--mtp-accent);
    box-shadow: 0 6px 16px -8px rgba(0, 0, 0, 0.5);
    transition: transform 0.4s cubic-bezier(0.3, 0.7, 0.2, 1), width 0.4s cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  /* Product cards, scoped to this section */
  .mtp .card-wrapper { height: 100%; }
  .mtp .card { background: transparent; }
  .mtp .card__inner,
  .mtp .card__inner .card__media,
  .mtp .card .media { border-radius: 14px; overflow: hidden; }
  .mtp .card__inner { background: #fff; }
  .mtp .card .media { background: #fff; }
  .mtp .card .media img { object-fit: cover; transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.4s ease; }
  .mtp .card-wrapper:hover .card .media img:first-child { transform: scale(1.05); }
  .mtp .card__content { padding: 0; }
  .mtp .card__information { padding: 1.4rem 0.2rem 0; }
  .mtp .card__heading { margin-bottom: 0.4rem; font-size: 1.35rem; line-height: 1.35; font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; }
  .mtp .card__heading a { text-decoration: none; }
  .mtp .card__heading a::after { outline: none !important; }
  .mtp .price { font-size: 1.4rem; font-weight: 600; letter-spacing: 0.02em; }
  .mtp .price--on-sale .price-item--regular { opacity: 0.5; }
  .mtp .price--on-sale .price-item--sale { color: #d0021b; }
  .mtp .card__badge { padding: 1rem; }
  .mtp .badge { padding: 0.5rem 1.1rem; border-radius: 999px; border: 0; background: #d0021b; color: #fff; font-size: 1.05rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  @supports (animation-timeline: view()) {
    .mtp__item { animation: mtp-reveal linear both; animation-timeline: view(); animation-range: entry 0% entry 40%; }
  }
  @keyframes mtp-reveal { from { opacity: 0; transform: translateY(32px); } to { opacity: 1; transform: none; } }
  .mtp__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--mtp-cols-mobile), minmax(0, 1fr));
    gap: 2.4rem 1.2rem;
  }
  .mtp__panel:not([hidden]) { animation: mtp-fade 0.4s ease both; }
  @keyframes mtp-fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  @media screen and (min-width: 750px) {
    .mtp__grid { grid-template-columns: repeat(min(3, var(--mtp-cols)), minmax(0, 1fr)); gap: 3.2rem 2rem; }
  }
  @media screen and (min-width: 990px) {
    .mtp { padding-top: var(--mtp-pt); padding-bottom: var(--mtp-pb); }
    .mtp__grid { grid-template-columns: repeat(var(--mtp-cols), minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mtp__indicator { transition: none; }
    .mtp__panel:not([hidden]), .mtp__item { animation: none !important; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('modular-tabs')) {
    customElements.define(
      'modular-tabs',
      class ModularTabs extends HTMLElement {
        connectedCallback() {
          this.tabs = Array.from(this.querySelectorAll('[role="tab"]'));
          this.indicator = this.querySelector('.mtp__indicator');
          this.shopAll = this.querySelector('.mtp__shop-all');
          if (!this.tabs.length) return;

          this.onClick = (event) => this.select(this.tabs.indexOf(event.currentTarget), false);
          this.onKeydown = (event) => {
            const current = this.tabs.indexOf(event.currentTarget);
            let next = null;
            if (event.key === 'ArrowRight') next = (current + 1) % this.tabs.length;
            if (event.key === 'ArrowLeft') next = (current - 1 + this.tabs.length) % this.tabs.length;
            if (event.key === 'Home') next = 0;
            if (event.key === 'End') next = this.tabs.length - 1;
            if (next === null) return;
            event.preventDefault();
            this.select(next, true);
          };
          this.moveIndicator = () => {
            const active = this.tabs.find((tab) => tab.getAttribute('aria-selected') === 'true');
            if (!active || !this.indicator) return;
            this.indicator.style.width = `${active.offsetWidth}px`;
            this.indicator.style.transform = `translateX(${active.offsetLeft}px)`;
          };

          this.tabs.forEach((tab) => {
            tab.addEventListener('click', this.onClick);
            tab.addEventListener('keydown', this.onKeydown);
          });
          // Tab widths change when the web font finishes loading, so watch each tab, not just the wrapper.
          this.resizeObserver = new ResizeObserver(this.moveIndicator);
          this.resizeObserver.observe(this);
          this.tabs.forEach((tab) => this.resizeObserver.observe(tab));
          document.fonts?.ready.then(this.moveIndicator);
          this.moveIndicator();
        }

        disconnectedCallback() {
          this.tabs?.forEach((tab) => {
            tab.removeEventListener('click', this.onClick);
            tab.removeEventListener('keydown', this.onKeydown);
          });
          this.resizeObserver?.disconnect();
        }

        select(index, focus) {
          this.tabs.forEach((tab, i) => {
            const selected = i === index;
            tab.setAttribute('aria-selected', String(selected));
            tab.tabIndex = selected ? 0 : -1;
            const panel = document.getElementById(tab.getAttribute('aria-controls'));
            if (panel) panel.hidden = !selected;
          });
          const active = this.tabs[index];
          if (focus) active.focus();
          active.scrollIntoView({ block: 'nearest', inline: 'nearest' });
          if (this.shopAll && active.dataset.url) this.shopAll.href = active.dataset.url;
          this.moveIndicator();
        }
      }
    );
  }

  document.addEventListener('shopify:block:select', (event) => {
    const tab = event.target.closest('modular-tabs [role="tab"]');
    if (tab) tab.click();
  });
{% endjavascript %}

{% schema %}
{
  "name": "Modular: Tabbed products",
  "tag": "div",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Most wanted this week" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trending now" },
    { "type": "text", "id": "shop_all_label", "label": "Shop all label", "default": "Shop all", "info": "Links to the active tab's collection." },
    { "type": "range", "id": "products_to_show", "label": "Products per tab", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    { "type": "color", "id": "accent_color", "label": "Active tab", "default": "#0B0B0B" },
    { "type": "color", "id": "background", "label": "Background", "default": "#F4F3F0" },
    { "type": "header", "content": "Product card" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "arch", "label": "Arch" },
        { "value": "blob", "label": "Blob" },
        { "value": "round", "label": "Circle" }
      ],
      "default": "default"
    },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Show second image on hover", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_rating", "label": "Show product rating", "default": false },
    {
      "type": "select",
      "id": "quick_add",
      "label": "Quick add",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" }
      ],
      "default": "none"
    },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "What's hot" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Modular: Tabbed products",
      "blocks": [
        { "type": "tab", "settings": { "label": "What's hot" } },
        { "type": "tab", "settings": { "label": "Best sellers" } },
        { "type": "tab", "settings": { "label": "Sale" } }
      ]
    }
  ]
}
{% endschema %}
